<mxfile host="drawio"><diagram name="req [Package] LEP Requirements" id="01-requirements"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="req [Package] Language Exchange Platform requirements" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=none;strokeColor=#666666;dashed=0;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1850" height="900" as="geometry"/></mxCell><mxCell id="c3" value="«requirement» Functional requirements (containment)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=none;strokeColor=#666666;dashed=0;fontStyle=1;align=left;spacingLeft=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1260" height="690" as="geometry"/></mxCell><mxCell id="c4" value="«requirement» Non-functional requirements (containment)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=none;strokeColor=#666666;dashed=0;fontStyle=1;align=left;spacingLeft=8;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1320" y="50" width="530" height="690" as="geometry"/></mxCell><mxCell id="c5" value="«requirement»&lt;br&gt;Account access&lt;br&gt;id = R001  (LEP-6)&lt;br&gt;text = A learner registers and logs in&lt;br&gt;— satisfiedBy: auth controller, User model&lt;br&gt;— verifiedBy: manual demo" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="260" height="150" as="geometry"/></mxCell><mxCell id="c6" value="«requirement»&lt;br&gt;Role-based access&lt;br&gt;id = R002  (LEP-7)&lt;br&gt;text = Learners can&#x27;t use moderator actions&lt;br&gt;— satisfiedBy: requireRole check&lt;br&gt;— verifiedBy: TC07" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="520" width="260" height="150" as="geometry"/></mxCell><mxCell id="c7" value="«requirement»&lt;br&gt;Language profile&lt;br&gt;id = R003  (LEP-6)&lt;br&gt;text = Up to 5 languages spoken and 5 learning&lt;br&gt;— satisfiedBy: auth controller, User model&lt;br&gt;— verifiedBy: TC10" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="260" height="150" as="geometry"/></mxCell><mxCell id="c8" value="«requirement»&lt;br&gt;Partner search&lt;br&gt;id = R004  (LEP-8)&lt;br&gt;text = Search by a language spoken, not showing yourself or hidden profiles&lt;br&gt;— satisfiedBy: request controller&lt;br&gt;— verifiedBy: manual demo" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="260" height="150" as="geometry"/></mxCell><mxCell id="c9" value="«requirement»&lt;br&gt;Send partner request&lt;br&gt;id = R005  (LEP-9)&lt;br&gt;text = Not to yourself, and only one pending or accepted request between two people&lt;br&gt;— satisfiedBy: request controller&lt;br&gt;— verifiedBy: TC01, TC02, TC03" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1020" y="300" width="260" height="150" as="geometry"/></mxCell><mxCell id="c10" value="«requirement»&lt;br&gt;Respond to request&lt;br&gt;id = R006  (LEP-10)&lt;br&gt;text = Recipient accepts or declines, sender cancels, only while pending&lt;br&gt;— satisfiedBy: request controller&lt;br&gt;— verifiedBy: TC04, TC05" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="300" width="260" height="150" as="geometry"/></mxCell><mxCell id="c11" value="«requirement»&lt;br&gt;Book session&lt;br&gt;id = R007  (LEP-11)&lt;br&gt;text = Partners on an accepted request book a session in the future, 15 to 120 minutes&lt;br&gt;— satisfiedBy: session controller&lt;br&gt;— verifiedBy: TC06" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="260" height="150" as="geometry"/></mxCell><mxCell id="c12" value="«requirement»&lt;br&gt;Cancel session&lt;br&gt;id = R008  (LEP-12)&lt;br&gt;text = Either partner cancels before it starts&lt;br&gt;— satisfiedBy: session controller&lt;br&gt;— verifiedBy: TC11" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="260" height="150" as="geometry"/></mxCell><mxCell id="c13" value="«requirement»&lt;br&gt;Hide profile&lt;br&gt;id = R009  (LEP-13)&lt;br&gt;text = A moderator hides a learner from search and new requests&lt;br&gt;— satisfiedBy: moderation controller&lt;br&gt;— verifiedBy: TC09" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="260" height="150" as="geometry"/></mxCell><mxCell id="c14" value="«requirement»&lt;br&gt;Input validation&lt;br&gt;id = R010  (LEP-16)&lt;br&gt;text = Form input is checked before it is saved, with a message for each bad field&lt;br&gt;— satisfiedBy: validate check&lt;br&gt;— verifiedBy: TC08" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1340" y="90" width="240" height="150" as="geometry"/></mxCell><mxCell id="c15" value="«requirement»&lt;br&gt;Cloud deployment&lt;br&gt;id = R011  (LEP-14)&lt;br&gt;text = Requests (R005, R006) work on the university EC2 and still work after a restart&lt;br&gt;— satisfiedBy: nginx, pm2, DEPLOY.md&lt;br&gt;— verifiedBy: EC2 demo" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1590" y="90" width="240" height="150" as="geometry"/></mxCell><mxCell id="c17" value="«requirement»&lt;br&gt;Secret handling&lt;br&gt;id = R012  (LEP-14)&lt;br&gt;text = No passwords or keys in the repository, only in .env on the server&lt;br&gt;— satisfiedBy: .gitignore, DEPLOY.md&lt;br&gt;— verifiedBy: commit history check" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1340" y="300" width="240" height="150" as="geometry"/></mxCell><mxCell id="c18" value="«deriveReqt»" style="endArrow=open;dashed=1;html=1;fontSize=10;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="«deriveReqt»" style="endArrow=open;dashed=1;html=1;fontSize=10;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="«deriveReqt»" style="endArrow=open;dashed=1;html=1;fontSize=10;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="«refine»" style="endArrow=open;dashed=1;html=1;fontSize=10;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="«deriveReqt»" style="endArrow=open;dashed=1;html=1;fontSize=10;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="«trace»" style="endArrow=open;dashed=1;html=1;fontSize=10;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="«testCase» TC01 request to yourself refused · TC02 valid request saved · TC03 second open request refused · TC04 sender can&#x27;t accept · TC05 closed request can&#x27;t change&lt;br&gt;TC06 can&#x27;t book on a pending request · TC07 learner refused on a moderator route · TC08 bad input gets a message · TC09 moderator hides a learner · TC10 six languages refused · TC11 partner cancels a session  (Mocha tests)" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="1790" height="50" as="geometry"/></mxCell><mxCell id="c25" value="Learner" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1110" y="120" width="50" height="70" as="geometry"/></mxCell><mxCell id="c26" value="Moderator" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=4;fontSize=11;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="140" y="560" width="